# Portal Entregador — Frontend env vars
# Copie para .env.local e preencha. NUNCA commitar .env.local.

# API backend (Cloud Run em produção, localhost:5000 em dev)
VITE_API_URL=http://localhost:5000

# Supabase Realtime (GPS)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Firebase Cloud Messaging (push notifications)
VITE_FIREBASE_API_KEY=
